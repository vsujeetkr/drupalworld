services:
  swagger:
    image: swaggerapi/swagger-ui:latest
    container_name: ddev-${DDEV_SITENAME}-swagger

    environment:
      SWAGGER_JSON: /usr/share/nginx/html/openapi.yaml

    volumes:
      - ../docs/openapi.yaml:/usr/share/nginx/html/openapi.yaml:ro

    labels:
      com.ddev.site-name: ${DDEV_SITENAME}
      com.ddev.approot: ${DDEV_APPROOT}

    expose:
      - "8080"

    environment:
      SWAGGER_JSON: /usr/share/nginx/html/openapi.yaml
      VIRTUAL_HOST: swagger.${DDEV_HOSTNAME}
      HTTP_EXPOSE: 8080:8080
      HTTPS_EXPOSE: 8081:8080
